
#include<stdio.h>
int fact(int n){
 if(n==0)
 return 1;
 return n*fact(n-1);}
 
int main(){
   int n;
   printf("Enter Non negative Number:");
   scanf("%d",&n);
   if(n<0){
   printf("Negative number are invalid\n");
   return 0;}
   
   int r= fact(n);
   printf("Fact:%d\n",r);
   if((r%10!=0&&n>10)||r<=0)
   printf("Overflow happened\n");
   
   return 0;
   
  }    

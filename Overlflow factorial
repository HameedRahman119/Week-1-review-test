
#include<stdio.h>
int fact(int n){
 if(n==0)
 return 1;
 return n*fact(n-1);}
 
int main(){
   int n;
   printf("Enter Non negative Number:");
   scanf("%d",&n);
   if(n<0){
   printf("Negative number are invalid\n");
   return 0;}
   if(n<13)       //For 32bit integer
   {int r= fact(n);
   printf("Fact:%d\n",r);}
   else
   printf("Overflow happened\n");
   
   return 0;
   
  }    
